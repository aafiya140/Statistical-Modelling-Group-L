# 2. Compare the log and square-root links ---------------------------------
# Reuse the Week 2 predictors, but model goals as Poisson counts.
# Goals conceded is a contemporaneous outcome, so this is an exploratory
# association model, not a validated pre-match prediction model.
model_log <- glm(goals_scored ~ home_away + rank_c + goals_conceded,
                 family = poisson(link = "log"), data = matches)
model_sqrt <- glm(goals_scored ~ home_away + rank_c + goals_conceded,
                  family = poisson(link = "sqrt"), data = matches)
stopifnot(model_log$converged, model_sqrt$converged,
          all(predict(model_sqrt, type = "link") > 0))
cat("\nINITIAL LOG-LINK MODEL\n")
print(summary(model_log))
cat("\nINITIAL SQUARE-ROOT-LINK MODEL\n")
print(summary(model_sqrt))
link_comparison <- data.frame(
  link = c("Log", "Square root"),
  residual_deviance = c(deviance(model_log), deviance(model_sqrt)),
  residual_df = c(df.residual(model_log), df.residual(model_sqrt)),
  AIC = c(AIC(model_log), AIC(model_sqrt)))
print(link_comparison)
# These links are not nested: compare AIC and plots, not a chi-square LRT.
# sqrt(mu) = eta requires eta >= 0; its coefficients are NOT log rate ratios.

# 3. Nested-model comparisons and model simplification ---------------------
# Check whether the rank slope differs between home and away matches.
model_interaction <- update(model_log, . ~ . + home_away:rank_c)
cat("\nCHECK THE HOME-BY-RANK INTERACTION\n")
print(drop1(model_interaction, test = "Chisq"))
print(anova(model_log, model_interaction, test = "Chisq"))
# The interaction is not supported in these data; retain additive effects.
cat("\nCHECK THE ADDITIVE PREDICTORS\n")
print(drop1(model_log, test = "Chisq"))
model_final <- update(model_log, . ~ . - goals_conceded)
print(anova(model_final, model_log, test = "Chisq"))
cat("\nSELECTED LOG-LINK MODEL\n")
print(summary(model_final))
print(drop1(model_final, test = "Chisq"))
model_null <- update(model_final, . ~ 1)
print(anova(model_null, model_final, test = "Chisq"))
# These choices reproduce this dataset's decisions, not an automatic rule
# for different data. A non-significant test does not prove no association.

model_comparison <- data.frame(
  model = c("Intercept only", "Log: all additive predictors",
            "Sqrt: all additive predictors", "Log: add home-by-rank interaction",
            "Log: home + rank (selected)"),
  parameters = c(model_null$rank, model_log$rank, model_sqrt$rank,
                 model_interaction$rank, model_final$rank),
  deviance = c(deviance(model_null), deviance(model_log), deviance(model_sqrt),
               deviance(model_interaction), deviance(model_final)),
  residual_df = c(df.residual(model_null), df.residual(model_log),
                  df.residual(model_sqrt), df.residual(model_interaction),
                  df.residual(model_final)),
  AIC = c(AIC(model_null), AIC(model_log), AIC(model_sqrt),
          AIC(model_interaction), AIC(model_final)))
print(model_comparison, row.names = FALSE)

# 4. Interpret expected-goal ratios and calculate fitted means -------------
coefficient_table <- coef(summary(model_final))
wald_ci <- confint.default(model_final, level = 0.95)
effect_table <- data.frame(
  term = names(coef(model_final)), estimate = coef(model_final),
  SE = coefficient_table[, "Std. Error"],
  exp_estimate = exp(coef(model_final)),
  lower_95 = exp(wald_ci[, 1]), upper_95 = exp(wald_ci[, 2]),
  Wald_p = coefficient_table[, "Pr(>|z|)"])
cat("\nCOEFFICIENTS AND 95% WALD INTERVALS\n")
print(effect_table, row.names = FALSE)
# exp(intercept) is expected goals away against rank 10, not a ratio.
# exp(home coefficient) is Home/Away at the same opponent rank.
# exp(rank coefficient) is the ratio for one numerically larger rank.

prediction_examples <- expand.grid(
  opponent_rank = c(1, 10, 24),
  home_away = factor(c("Away", "Home"), levels = c("Away", "Home")))
prediction_examples$rank_c <- prediction_examples$opponent_rank - 10
pred <- predict(model_final, newdata = prediction_examples,
                type = "link", se.fit = TRUE)
prediction_examples$expected_goals <- exp(pred$fit)
prediction_examples$lower_95 <- exp(pred$fit - qnorm(0.975) * pred$se.fit)
prediction_examples$upper_95 <- exp(pred$fit + qnorm(0.975) * pred$se.fit)
print(prediction_examples, row.names = FALSE)
# These are confidence intervals for the mean, not individual-match intervals.

# 5. Goodness of fit, dispersion and influence -----------------------------
n <- nrow(matches)
p <- model_final$rank
mu <- fitted(model_final)
standardised_deviance <- rstandard(model_final, type = "deviance")
pearson_statistic <- sum(residuals(model_final, type = "pearson")^2)
dispersion <- pearson_statistic / df.residual(model_final)
gof_p <- pchisq(deviance(model_final), df.residual(model_final), lower.tail = FALSE)
cat("\nFIT CHECKS\n")
cat("Residual deviance =", deviance(model_final), "on",
    df.residual(model_final), "df; approximate GOF p =", gof_p, "\n")
cat("Pearson statistic =", pearson_statistic,
    "; Pearson dispersion estimate =", dispersion, "\n")
cat("Fitted-mean range:", range(mu), "\n")
cat("Observed zero counts:", sum(matches$goals_scored == 0),
    "; sum of fitted zero probabilities:", sum(dpois(0, mu)), "\n")
# Poisson fixes dispersion to 1 in summary(); that is NOT a test result.
# Low fitted counts make the chi-square GOF approximation imperfect.
# A QQ plot is descriptive: a Poisson response need not have normal errors.

diagnostics <- data.frame(matches[needed], row_id = matches$row_id,
                          fitted = mu,
                          std_deviance = standardised_deviance,
                          leverage = hatvalues(model_final),
                          cooks_distance = cooks.distance(model_final))
cat("Cook reference 4/n =", 4/n, "; leverage reference 2p/n =", 2*p/n, "\n")
print(diagnostics[order(diagnostics$cooks_distance, decreasing = TRUE), ],
      row.names = FALSE)

# 6. Refit after omitting each of the three largest Cook's-distance rows ----
# This is a sensitivity check; the selected main model keeps every match.
influential_rows <- head(order(diagnostics$cooks_distance, decreasing = TRUE), 3)
omission_models <- lapply(influential_rows, function(i) {
  update(model_final, data = matches[-i, ])
})
names(omission_models) <- paste0("Omit row ", influential_rows)
sensitivity_models <- c(list("All 46 matches" = model_final), omission_models)
sensitivity <- do.call(rbind, lapply(names(sensitivity_models), function(label) {
  fit <- sensitivity_models[[label]]
  b <- coef(fit); se <- sqrt(diag(vcov(fit)))
  tests <- drop1(fit, test = "Chisq")
  data.frame(analysis = label, n = nobs(fit),
    home_ratio = exp(b["home_awayHome"]),
    home_lower = exp(b["home_awayHome"] - qnorm(0.975)*se["home_awayHome"]),
    home_upper = exp(b["home_awayHome"] + qnorm(0.975)*se["home_awayHome"]),
    home_LRT_p = tests["home_away", "Pr(>Chi)"],
    rank_ratio = exp(b["rank_c"]),
    rank_lower = exp(b["rank_c"] - qnorm(0.975)*se["rank_c"]),
    rank_upper = exp(b["rank_c"] + qnorm(0.975)*se["rank_c"]),
    rank_LRT_p = tests["rank_c", "Pr(>Chi)"], row.names = NULL)
}))
cat("\nINFLUENCE SENSITIVITY (95% WALD INTERVALS; LRT P-VALUES)\n")
print(sensitivity, row.names = FALSE)

